# Canonical origin: https, no www — single 301 hop for any other form.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aewaittimes.co.uk%{REQUEST_URI} [L,R=301]

# Serve the site's own styled 404 page with the correct status.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Build assets are content-hashed, so they can be cached forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Keep HTML fresh — the site redeploys every half hour.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Geolocation stays available to our own near-me page; everything else off.
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
</IfModule>
